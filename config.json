{
  "clips": {
    "max_per_video": 6,
    "min_seconds": 18,
    "max_seconds": 58,
    "target_seconds": 35,
    "one_clip_per_n_minutes": 1.5
  },
  "transcription": {
    "whisper_model": "small",
    "language": null
  },
  "captions": {
    "burn_in": true,
    "words_per_line": 3,
    "font_size": 84,
    "uppercase": true
  },
  "post": {
    "backend": "tiktok",
    "tiktok_privacy": "auto",
    "caption_template": "{hook}\n\n{credit} {hashtags}",
    "credit_template": "🎥 {creator}",
    "hashtags": ["#fyp", "#clips"],
    "allow_comments": true,
    "allow_duet": false,
    "allow_stitch": false
  },
  "queue": {
    "low_queue_alert_days": 3,
    "posts_per_run": 1,
    "max_attempts": 3
  }
}
