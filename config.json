{
  "clips": {
    "max_per_video": 15,
    "min_seconds": 20,
    "max_seconds": 60,
    "target_seconds": 40,
    "one_clip_per_n_minutes": 1
  },
  "transcription": {
    "whisper_model": "small",
    "language": null
  },
  "captions": {
    "burn_in": true,
    "words_per_line": 3,
    "font_size": 84,
    "uppercase": true,
    "bleep_swears": true
  },
  "post": {
    "backend": "tiktok",
    "tiktok_privacy": "auto",
    "caption_template": "{hook}\n\n{credit} {hashtags}",
    "credit_template": "🎥 {creator}",
    "hashtags": [
      "#fyp",
      "#clips"
    ],
    "allow_comments": true,
    "allow_duet": false,
    "allow_stitch": false
  },
  "queue": {
    "low_queue_alert_days": 3,
    "posts_per_run": 1,
    "max_attempts": 3
  },
  "fetch": {
    "max_minutes": null
  },
  "watch": {
    "check_latest": 5,
    "min_minutes": 5,
    "first_run_take": 1,
    "max_downloads_per_run": 6,
    "transcribe": true
  }
}
